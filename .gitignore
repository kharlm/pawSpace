# Don't track content of these folders
.env
.env*.local
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Generated native projects (EAS Build regenerates these via prebuild)
/ios
/android

# Native credentials — never commit these
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# macOS
.DS_Store
*.pem

# debug
npm-debug.*
yarn-debug.*
yarn-error.*



# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip
